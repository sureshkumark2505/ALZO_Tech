# ================================================================
# ALZO TECH — PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# ================================================================

# 1. Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. ALZO Tech Receiving Emails (Multiple Recipient Support)
# Primary receiving email:
ALZO_CONTACT_EMAIL=primary@alzotech.com

# Secondary / Additional receiving email (optional):
ALZO_CONTACT_EMAIL_2=secondary@alzotech.com

# Alternatively, you can specify comma-separated emails in ALZO_CONTACT_EMAIL:
# ALZO_CONTACT_EMAIL=team@alzotech.com, director@alzotech.com

# 3. Verified Sender Address in Resend (Optional)
# For initial testing: ALZO Tech <onboarding@resend.dev>
# For production: ALZO Tech <notifications@yourverifieddomain.com>
ALZO_SENDER_EMAIL=ALZO Tech <onboarding@resend.dev>
