# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ALZO Tech Receiving Email
# The email address that will receive client enquiries
ALZO_CONTACT_EMAIL=contact@alzotech.com

# Optional: Verified Sender Address in Resend
# For testing: ALZO Tech <onboarding@resend.dev>
# For production: ALZO Tech <notifications@yourverifieddomain.com>
ALZO_SENDER_EMAIL=ALZO Tech <onboarding@resend.dev>
