# ================================================================
# ALZO TECH — PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# ================================================================

# 1. Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 2. ALZO Tech Receiving Email
# The email address that will receive client enquiries
ALZO_CONTACT_EMAIL=contact@alzotech.com

# 3. Verified Sender Address in Resend (Optional)
# For initial testing: ALZO Tech <onboarding@resend.dev>
# For production: ALZO Tech <notifications@yourverifieddomain.com>
ALZO_SENDER_EMAIL=ALZO Tech <onboarding@resend.dev>

# 4. CallMeBot Dual WhatsApp Notification API (Free)
# Receive automated WhatsApp alerts on BOTH numbers simultaneously:
#
# Primary Number: +91 
# Steps for Number 1 (30 seconds):
#   a) From +91 9342836527, open WhatsApp and send "I allow callmebot to send me messages" to +34 644 44 20 84
#   b) The bot will reply with your API Key.
CALLMEBOT_PHONE_1=919342836527
CALLMEBOT_API_KEY_1=your_callmebot_api_key_for_number_1

# Secondary Number: +91 
# Steps for Number 2 (30 seconds):
#   a) From +91 , open WhatsApp and send "I allow callmebot to send me messages" to +34 644 44 20 84
#   b) The bot will reply with your API Key.
CALLMEBOT_PHONE_2=918637455316
CALLMEBOT_API_KEY_2=your_callmebot_api_key_for_number_2
